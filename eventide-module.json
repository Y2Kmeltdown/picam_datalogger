{
  "name": "picam-datalogger",
  "version": "1.0.0",
  "description": "Raspberry Pi camera datalogger (segmented H.264 recording) with an MJPEG live-stream server.",
  "author": "Y2Kmeltdown",
  "dependencies": {
    "apt": ["python3-picamera2", "ffmpeg"]
  },
  "recordings_subdir": "picam",
  "arguments": [
    {
      "name": "segment_duration",
      "flag": "--segment-duration",
      "type": "int",
      "default": 60,
      "required": false,
      "description": "Length of each recorded video segment in seconds."
    },
    {
      "name": "stream_quality",
      "flag": "--quality",
      "type": "int",
      "default": 15,
      "required": false,
      "description": "JPEG quality for the live stream (1-100)."
    }
  ],
  "sockets": [
    {
      "name": "frames",
      "type": "unix",
      "path": "/tmp/picam_frames.sock",
      "description": "Raw-frame socket: pi_camera_datalogger publishes, pi_mjpeg_server consumes."
    },
    {
      "name": "mjpeg",
      "type": "tcp",
      "description": "MJPEG live stream plus /api/settings and /api/streaming. Port allocated by eventide at install time; reachable at /proxy/picam-datalogger/mjpeg/."
    }
  ],
  "ui": [
    {
      "id": "live",
      "type": "mjpeg",
      "title": "PICAM LIVE",
      "region": "center",
      "default": true,
      "socket": "mjpeg",
      "path": "/stream"
    },
    {
      "id": "stream-settings",
      "type": "form",
      "title": "PICAM STREAM",
      "region": "sidebar",
      "default": true,
      "socket": "mjpeg",
      "get": "/api/settings",
      "put": "/api/settings",
      "fields": [
        {"key": "quality", "label": "Quality", "kind": "slider", "min": 1, "max": 100},
        {"key": "out_width", "label": "Width", "kind": "number", "min": 1},
        {"key": "out_height", "label": "Height", "kind": "number", "min": 1},
        {"key": "streaming", "label": "Stream enabled", "kind": "toggle", "get": "/api/streaming", "put": "/api/streaming"}
      ]
    }
  ],
  "programs": [
    {
      "name": "pi_camera_datalogger",
      "command": "{venv_python} {module_dir}/camera_app.py --config {module_dir}/camera_config.json --output-dir {recordings_subdir} --socket {socket:frames} --segment-duration {arg:segment_duration}",
      "directory": "{module_dir}",
      "autostart": true,
      "autorestart": true,
      "startretries": 10000,
      "priority": 1,
      "user": "root"
    },
    {
      "name": "pi_mjpeg_server",
      "command": "{venv_python} {module_dir}/mjpeg_server.py --socket {socket:frames} --port {socket:mjpeg} --quality {arg:stream_quality}",
      "directory": "{module_dir}",
      "autostart": true,
      "autorestart": true,
      "startretries": 10000,
      "priority": 2,
      "user": "root"
    }
  ]
}
